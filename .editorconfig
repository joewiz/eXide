root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{xq,xqm,xql,xquery,xsl,xslt,xml,xsd,xconf,rng,html,tmpl}]
indent_size = 4

[*.{js,mjs,cjs,ts,css,less,yml,yaml,json,jsonc,md}]
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
